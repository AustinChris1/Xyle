# === LIVE TELEGRAPH ===
FORCE_MOCK=false
TELEGRAPH_NODE_URL=http://13.237.89.59:7044
MINER_DISPATCHER_PREFIX=/miner-dispatcher/v1

# Four distinct miners. Probe before trusting a swap: the catalog
# descriptions are not always accurate about which models a miner accepts.
# Evidence older than this does not count. Without it Tavily happily returns
# nine-month-old articles and a "next 48 hours" market settles on them.
NEWS_WINDOW_DAYS=7

NEWS_MINER_ID=202
NEWS_PATH=/search
NEWS_LABEL=Tavily
NEWS_ALT_MINER_ID=210
NEWS_ALT_LABEL=GNews

# Authenticity. Miner 109 (Gemini) is quota-exhausted upstream, so 115 is used.
AUTH_MINER_ID=115
AUTH_PATH=/chat
AUTH_MODEL=deepseek
AUTH_LABEL=DeepSeek

REASON_MINER_ID=110
REASON_PATH=/chat
REASON_MODEL=openai/gpt-4o-mini
REASON_LABEL=OpenRouter

CONSENSUS_MINER_ID=104
CONSENSUS_PATH=/chat
CONSENSUS_MODEL=nova-2-lite
CONSENSUS_LABEL=LiteLLM Nova

COST_USDC_PER_CALL=0.01
ORACLE_INTERVAL_MINUTES=15

# Public verify endpoint spends real USDC on every request
VERIFY_PER_IP_HOURLY=6
VERIFY_DAILY_CAP_USDC=2

# Base Sepolia payment (required for live)
EVM_PRIVATE_KEY=
EVM_NETWORK=eip155:84532

# Turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cron guards. A reading is ~15s / ~0.04 USDC. Ticking every open market in one
# invocation exceeds the 60s serverless limit past ~3 markets and drains the
# wallet fast at a 15m cadence. Markets rotate oldest-read first.
CRON_MARKETS_PER_CYCLE=2
CRON_AUTO_MARKETS=true
CRON_AUTO_MARKETS_PER_CYCLE=1
CRON_DAILY_CAP_USDC=5
# Stop opening new markets past this many open, or the board grows faster than
# readings can clear it.
CRON_MAX_OPEN_MARKETS=12

# MUST match your real scheduler cadence: it drives the "next reading" countdown.
ORACLE_INTERVAL_MINUTES=60

# Cron (daily in vercel.json on Hobby; use cron-job.org for 15m)
CRON_SECRET=change-me-to-a-long-random-string

# SIWE session cookie (min 32 chars). Required in production.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

NEXT_PUBLIC_APP_URL=http://localhost:3000
ORACLE_TIMEOUT_MS=45000

# Signs outgoing agent webhooks (X-Signal-Arena-Signature). Falls back to SESSION_SECRET.
WEBHOOK_SECRET=
# Only for local testing against http/localhost receivers
ALLOW_INSECURE_WEBHOOKS=false
