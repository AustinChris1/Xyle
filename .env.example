# === LIVE TELEGRAPH ===
FORCE_MOCK=false
TELEGRAPH_NODE_URL=http://13.237.89.59:7044
MINER_DISPATCHER_PREFIX=/miner-dispatcher/v1

# Four distinct miners. Probe before trusting a swap: the catalog
# descriptions are not always accurate about which models a miner accepts.
NEWS_MINER_ID=202
NEWS_PATH=/search
NEWS_LABEL=Tavily
NEWS_ALT_MINER_ID=210
NEWS_ALT_LABEL=GNews

# Authenticity. Miner 109 (Gemini) is quota-exhausted upstream, so 115 is used.
AUTH_MINER_ID=115
AUTH_PATH=/chat
AUTH_MODEL=deepseek
AUTH_LABEL=DeepSeek

REASON_MINER_ID=110
REASON_PATH=/chat
REASON_MODEL=openai/gpt-4o-mini
REASON_LABEL=OpenRouter

CONSENSUS_MINER_ID=104
CONSENSUS_PATH=/chat
CONSENSUS_MODEL=nova-2-lite
CONSENSUS_LABEL=LiteLLM Nova

COST_USDC_PER_CALL=0.01
ORACLE_INTERVAL_MINUTES=15

# Public verify endpoint spends real USDC on every request
VERIFY_PER_IP_HOURLY=6
VERIFY_DAILY_CAP_USDC=2

# Base Sepolia payment (required for live)
EVM_PRIVATE_KEY=
EVM_NETWORK=eip155:84532

# Turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cron (Vercel every 15m or cron-job.org)
CRON_SECRET=change-me-to-a-long-random-string

NEXT_PUBLIC_APP_URL=http://localhost:3000
ORACLE_TIMEOUT_MS=45000
